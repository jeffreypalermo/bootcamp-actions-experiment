@page "/impostor-game"

<PageTitle>Impostor Game</PageTitle>

<div class="impostor-page">
    <div class="impostor-container">
        <div class="impostor-header">
            <h2>🎭 Impostor Game</h2>
            <div class="impostor-subtitle">Find the impostor among you!</div>
        </div>

        @if (_gameState == GameState.Setup)
        {
            <div class="setup-card">
                <h3>Game Setup</h3>
                
                <div class="form-group">
                    <label for="playerCount">Number of Players:</label>
                    <select id="playerCount" class="form-control" @bind="_selectedPlayerCount">
                        @for (int i = 2; i <= 10; i++)
                        {
                            <option value="@i">@i Players</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="theme">Theme:</label>
                    <select id="theme" class="form-control" @bind="_selectedTheme">
                        <option value="Technology">Technology</option>
                        <option value="Animals">Animals</option>
                        <option value="People">People</option>
                        <option value="Sports">Sports</option>
                        <option value="OldTestament">Old Testament</option>
                        <option value="NewTestament">New Testament</option>
                        <option value="Jesus">Jesus</option>
                        <option value="TheFlood">The Flood</option>
                        <option value="Revelation">Revelation</option>
                    </select>
                </div>

                <button class="btn btn-primary start-btn" @onclick="StartGame">
                    🎮 Start Game
                </button>
            </div>
        }
        else if (_gameState == GameState.PlayerReveal)
        {
            <div class="reveal-card">
                <h3>Player @(_currentPlayer + 1) of @_selectedPlayerCount</h3>
                
                @if (!_wordRevealed)
                {
                    <div class="reveal-instructions">
                        <p>Player @(_currentPlayer + 1), get ready!</p>
                        <p>Press the button below to see your word.</p>
                        <p class="warning-text">⚠️ Keep it secret from other players!</p>
                    </div>
                    
                    <button class="btn btn-primary reveal-btn" @onclick="RevealWord">
                        👁️ Reveal My Word
                    </button>
                }
                else
                {
                    <div class="word-display">
                        @if (_currentPlayer == _impostorIndex)
                        {
                            <div class="impostor-message">
                                <h2>🎭 YOU ARE THE IMPOSTOR!</h2>
                                <p>Try to blend in and figure out what the secret word is!</p>
                            </div>
                        }
                        else
                        {
                            <div class="secret-word">
                                <h2>@_secretWord</h2>
                            </div>
                        }
                    </div>
                    
                    <button class="btn btn-secondary hide-btn" @onclick="HideWord">
                        🙈 Hide Word & Pass Device
                    </button>
                }
            </div>
        }
        else if (_gameState == GameState.Playing)
        {
            <div class="playing-card">
                <h3>🎮 Game in Progress</h3>
                
                <div class="game-info">
                    <div class="info-item">
                        <strong>Players:</strong> @_selectedPlayerCount
                    </div>
                    <div class="info-item">
                        <strong>Theme:</strong> @GetThemeDisplayName(_selectedTheme)
                    </div>
                </div>

                <div class="instructions">
                    <h4>How to Play:</h4>
                    <ol>
                        <li>Each player takes turns describing the secret word without saying it directly</li>
                        <li>The impostor must try to blend in without knowing the word</li>
                        <li>After discussion, vote on who you think the impostor is</li>
                        <li>If the impostor is found, the group wins! If not, the impostor wins!</li>
                    </ol>
                </div>

                <button class="btn btn-danger reset-btn" @onclick="ResetGame">
                    🔄 Reset Game
                </button>
            </div>
        }
    </div>
</div>

