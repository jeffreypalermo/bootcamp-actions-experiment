    private void StartGame()
    {
        _impostorIndex = Random.Shared.Next(0, _selectedPlayerCount);
        
        var words = _wordBanks[_selectedTheme];
        _secretWord = words[Random.Shared.Next(words.Count)];
        
        _currentPlayer = 0;
        _wordRevealed = false;
        _gameState = GameState.PlayerReveal;
    }

    private void RevealWord()
    {
        _wordRevealed = true;
    }

    private void HideWord()
    {
        _wordRevealed = false;
        _currentPlayer++;
        
        if (_currentPlayer >= _selectedPlayerCount)
        {
            _gameState = GameState.Playing;
        }
    }

    private void ResetGame()
    {
        _gameState = GameState.Setup;
        _currentPlayer = 0;
        _impostorIndex = 0;
        _secretWord = "";
        _wordRevealed = false;
    }

    private string GetThemeDisplayName(string theme)
    {
        return theme switch
